# Production env vars for guitar.ideajetlab.com on VPS2.
# Copy to .env on the VPS at /root/guitar-app/.env and fill values.

# Postgres password (used to construct DATABASE_URL inside the compose)
POSTGRES_PASSWORD=__GENERATE__

# Auth — JWT_SECRET must be at least 32 chars, APP_ENCRYPTION_KEY must be 32 bytes (hex or base64).
# Generate with:  openssl rand -base64 48 | tr -d '\n='   ;   openssl rand -hex 32
JWT_SECRET=__GENERATE__
APP_ENCRYPTION_KEY=__GENERATE__

# CORS / cookie origin
FRONTEND_ORIGIN=https://guitar.ideajetlab.com

# First-boot admin (only used if app_users is empty; ADMIN_PASSWORD is optional —
# leave blank to have one auto-generated and printed to the backend log on first start)
ADMIN_EMAIL=edgars@ideajetlab.com
ADMIN_PASSWORD=

# Optional Cloud Run analyzers
MADMOM_SERVICE_URL=https://madmom-service-598884178881.us-central1.run.app
BTC_SERVICE_URL=
